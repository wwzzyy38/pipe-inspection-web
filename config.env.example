# Copy to config.env on the device. It is sourced by run.sh; do not commit it.
PIPE_WEB_PORT=18120
# The default is loopback HTTP. To enable access on a private LAN, set ALL four:
# PIPE_WEB_BIND=192.168.50.20
# PIPE_WEB_ALLOW=192.168.50.0/24
# PIPE_WEB_CERT="$PWD/web-security/site-cert.pem"
# PIPE_WEB_KEY="$PWD/web-security/site-key.pem"
# And set the device password file:
# PIPE_WEB_PASSWORD_FILE="$PWD/web-security/password.json"
# Optional short DNS label and Tailscale IPv4 (requires the TLS settings above):
# PIPE_WEB_HOSTNAME=inspection
# PIPE_WEB_TAIL_BIND=100.64.0.20
# Certificates must include the IPs and names clients actually use in their SAN.

PIPE_WEB_RECORDINGS="$PWD/recordings"
# PIPE_WEB_BAG_ROOT="$HOME/recorded-flight-bags"
# Edit paths on each deployment; weights and third-party source are not included.
PIPE_YOLO_PYTHON="$PWD/runtime/python-cuda"
PIPE_YOLO_MODEL="$PWD/assets/weights/yolo26m.pt"
PIPE_POINT_PYTHON="$PWD/runtime/python-cuda"
PIPE_POINT_UPSTREAM="$PWD/model_ws/openpoints-source"
PIPE_POINT_MODEL="$PWD/assets/weights/pointnext-b-best62.pt"
ROS_LOG_DIR="$PWD/logs/ros"
